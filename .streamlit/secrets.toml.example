# Modele de secrets pour Streamlit Community Cloud.
# Sur Streamlit Cloud : Settings > Secrets, coller ce contenu avec les vraies valeurs.
# En local : copier vers .streamlit/secrets.toml (ignore par Git).

[openbravo]
url = "https://intersport.cloud.openbravo.com/openbravo/ws"
username = "VOTRE_UTILISATEUR_API"
password = "VOTRE_MOT_DE_PASSE_API"
stores = [
    "Magasin Felgueiras",
]

# Optionnel : moteur External Discount (sinon mode demo/stub)
# [external_discount]
# url = "..."
# username = "..."
# password = "..."
